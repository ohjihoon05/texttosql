# wonik4 오프라인 PC 전용 설정
# 사용법: cp .env.wonik4 .env

# LLM Configuration - wonik4 로컬 Ollama
LLM_BASE_URL=http://localhost:11435
LLM_MODEL=gpt-oss:20b
LLM_FALLBACK_MODEL=llama3.2:1b
LLM_TIMEOUT=60

# Cache Configuration
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE=200
CACHE_DB_PATH=data/cache.db

# Excel Configuration
MAX_EXCEL_SIZE_MB=10
MAX_SHEETS=50
MAX_RELEVANT_SHEETS=5

# Chainlit Configuration
CHAINLIT_PORT=3003
CHAINLIT_HOST=0.0.0.0
